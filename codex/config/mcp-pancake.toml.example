# Pancake CMO MCP server — Codex CLI config (manual-install fallback only; see ../README.md
# for the recommended `codex plugin marketplace add` / `codex plugin add` install path, which
# needs no manual config.toml editing).
#
# Append this block to ~/.codex/config.toml (or a trusted project's .codex/config.toml), then
# run `codex mcp login pancake` — authentication is a browser sign-in to your Pancake account
# (OAuth), so there is NO key, token, or env var to configure. Nothing in this file is secret.

[mcp_servers.pancake]
url = "https://app.getpancake.ai/api/mcp"
